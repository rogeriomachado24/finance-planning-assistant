# Copy to backend/.env and adjust. Every setting is optional.

# SQLite file by default (backend/finance.db).
# DATABASE_URL=sqlite:///path/to/finance.db

# Chat: "mock" needs no model (rules + templates); "ollama" uses a local model for the
# messages the rules can't understand, and falls back to the rules whenever it can't be used.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b-instruct
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Let the model reword replies (strictly checked; falls back to templates). Off by default:
# with phi3 the rewording introduced errors that automated checks can't catch.
# OLLAMA_REWRITE_REPLIES=false
